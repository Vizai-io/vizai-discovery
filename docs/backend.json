
{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "An enterprise organization using the VizAI platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "organizationId": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email", "role", "organizationId"]
    },
    "CompanyProfile": {
      "title": "Company Profile",
      "description": "Details of a company being scanned for AI visibility.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "industry": { "type": "string" },
        "serviceCategories": { "type": "array", "items": { "type": "string" } },
        "targetGeography": { "type": "string" },
        "competitors": { "type": "array", "items": { "type": "string" } },
        "foundingYear": { "type": "number" },
        "employeeSize": { "type": "string" },
        "operatingRegions": { "type": "array", "items": { "type": "string" } },
        "googleBusinessProfileUrl": { "type": "string", "format": "uri" },
        "linkedInPageUrl": { "type": "string", "format": "uri" },
        "directoryListings": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "monitoringFrequency": { "type": "string", "enum": ["off", "weekly", "biweekly", "monthly"] },
        "nextScanAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "industry"]
    },
    "PresenceSignal": {
      "title": "Presence Signal",
      "description": "Signals indicating the company's local and professional presence across the web.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "hasGoogleBusiness": { "type": "boolean" },
        "hasLinkedIn": { "type": "boolean" },
        "directoryCount": { "type": "number" },
        "citationWeight": { "type": "number" },
        "authorityBoost": { "type": "number" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "profileId"]
    },
    "EntitySignal": {
      "title": "Entity Signal",
      "description": "Enriched business entity data used to weight AI visibility algorithms.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "authorityWeight": { "type": "number" },
        "serviceCoverageWeight": { "type": "number" },
        "geographicRelevanceWeight": { "type": "number" },
        "dataConfidence": { "type": "number" },
        "enrichedAttributes": { "type": "object" },
        "extractedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "profileId"]
    },
    "ScanRecord": {
      "title": "Scan Record",
      "description": "The result of an AI visibility scan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "results": { "type": "object" },
        "queryLibraryUsed": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "profileId", "status"]
    },
    "RealQueryResult": {
      "title": "Real Query Result",
      "description": "Actual response data from a live AI model for verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "scanId": { "type": "string" },
        "query": { "type": "string" },
        "model": { "type": "string" },
        "mentions": { "type": "array", "items": { "type": "object" } },
        "responseExcerpt": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Top-level organization accounts."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profiles."
    },
    "/companyProfiles/{profileId}": {
      "schema": "CompanyProfile",
      "description": "Monitored company entities."
    },
    "/entitySignals/{signalId}": {
      "schema": "EntitySignal",
      "description": "Technical entity enrichment data."
    },
    "/presenceSignals/{signalId}": {
      "schema": "PresenceSignal",
      "description": "Local and professional presence signals."
    },
    "/websiteSignals/{signalId}": {
      "schema": "WebsiteSignal",
      "description": "Intelligence signals extracted from company websites."
    },
    "/scans/{scanId}": {
      "schema": "ScanRecord",
      "description": "History of AI visibility scans."
    },
    "/realQueryResults/{resultId}": {
      "schema": "RealQueryResult",
      "description": "Live AI model verification results."
    }
  }
}
