
{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "An enterprise organization using the VizAI platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "organizationId": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email", "role", "organizationId"]
    },
    "CompanyProfile": {
      "title": "Company Profile",
      "description": "Details of a company being scanned for AI visibility.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "industry": { "type": "string" },
        "serviceCategories": { "type": "array", "items": { "type": "string" } },
        "targetGeography": { "type": "string" },
        "competitors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "monitoringFrequency": { "type": "string", "enum": ["off", "weekly", "biweekly", "monthly"] },
        "nextScanAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "industry"]
    },
    "CompetitorProfile": {
      "title": "Competitor Profile",
      "description": "A detailed profile of a competitor in the AI knowledge layer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "geography": { "type": "array", "items": { "type": "string" } },
        "authorityScore": { "type": "number" },
        "citationStrengthScore": { "type": "number" },
        "serviceCoverageScore": { "type": "number" }
      },
      "required": ["id", "name", "industry"]
    },
    "WebsiteSignal": {
      "title": "Website Signal",
      "description": "Extracted intelligence from a company's website.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "title": { "type": "string" },
        "metaDescription": { "type": "string" },
        "h1": { "type": "array", "items": { "type": "string" } },
        "jsonLdDetected": { "type": "boolean" },
        "serviceKeywords": { "type": "array", "items": { "type": "string" } },
        "locationReferences": { "type": "array", "items": { "type": "string" } },
        "extractedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "profileId"]
    },
    "ScanRecord": {
      "title": "Scan Record",
      "description": "The result of an AI visibility scan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "results": { "type": "object" },
        "queryLibraryUsed": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "profileId", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Top-level organization accounts."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profiles."
    },
    "/companyProfiles/{profileId}": {
      "schema": "CompanyProfile",
      "description": "Monitored company entities."
    },
    "/competitorProfiles/{compId}": {
      "schema": "CompetitorProfile",
      "description": "Modeled knowledge profiles of competitors."
    },
    "/websiteSignals/{signalId}": {
      "schema": "WebsiteSignal",
      "description": "Intelligence signals extracted from company websites."
    },
    "/scans/{scanId}": {
      "schema": "ScanRecord",
      "description": "History of AI visibility scans."
    }
  }
}
