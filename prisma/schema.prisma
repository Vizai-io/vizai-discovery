// VizAI Discovery — Prisma Schema
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────

enum OrgTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
  TIMEOUT
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum MatchStatus {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  NOT_MENTIONED
}

enum OmissionSeverity {
  MAJOR
  MINOR
}

enum ConsistencyLabel {
  HIGH_AGREEMENT
  MODERATE_DIVERGENCE
  SIGNIFICANT_DIVERGENCE
  EXTREME_DIVERGENCE
}

enum RecurrenceInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  VISIBILITY_IMPROVED
  VISIBILITY_DECLINED
  RECOMMENDATION_BACKLOG_GROWING
  RECOMMENDATION_MILESTONE
  ONBOARDING_COMPLETE
  BILLING_PAYMENT_FAILED
  BILLING_WARNING
  CONSULTATION_REQUEST_SUBMITTED
  // ── Sprint 12: Intelligence alerting ─────────────────────────────────────
  CONTINUITY_STATE_DECLINED // org continuity state rank dropped ≥1
  ARCHETYPE_TRANSITION // org moved to an at-risk operational archetype
  INTERVENTION_REQUIRED // intervention window reached IMMEDIATE
  RISK_ESCALATED // risk level crossed to HIGH or CRITICAL
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum TruthPublishStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum TruthCanonStatus {
  DRAFT
  APPROVED
  PUBLISHED
  SUPERSEDED
}

enum TruthEntityType {
  COMPANY
  BRAND
  SERVICE
  PRODUCT
  LOCATION
  INDUSTRY
  CERTIFICATION
  CLAIM
  EVIDENCE
  AUTHORITY_SOURCE
  COMPETITOR
  CUSTOMER_SEGMENT
  PERSON
  REGISTRY_PROFILE
}

enum TruthClaimStatus {
  DRAFT
  VERIFIED
  NEEDS_EVIDENCE
  REJECTED
  ARCHIVED
}

// WP-21B / DEC-032 — immutable provenance axis, separate from lifecycle status.
enum ClaimOrigin {
  OBSERVED
  DECLARED
}

enum EvidenceSourceType {
  WEBSITE
  SOCIAL_PROFILE
  DIRECTORY
  GOVERNMENT_RECORD
  TRADE_ASSOCIATION
  REVIEW_PLATFORM
  PRESS
  CUSTOMER_PROVIDED
  OTHER
  OWNER_ATTESTATION
}

enum EvidenceSupportLevel {
  STRONG
  MODERATE
  WEAK
  CONTRADICTS
}

enum TruthGraphRelationType {
  PROVIDES
  OPERATES_IN
  SERVES
  CERTIFIED_BY
  SUPPORTED_BY
  LISTED_ON
  COMPETES_WITH
  DERIVED_FROM
  CONTACT_FOR
  HAS_BRAND
}

enum RegistryProfileStatus {
  DRAFT
  READY
  PUBLISHED
  SUPERSEDED
}

enum AuthoritySourceStatus {
  PLANNED
  READY
  PUBLISHED
  NEEDS_UPDATE
  BLOCKED
}

enum DriftRunStatus {
  COMPLETE
  PARTIAL
  FAILED
}

enum DriftFindingSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// WP-VIZ-CRAWL-01 — registry intelligence operational control plane.
enum RegistryTargetStatus {
  NEW
  RESOLVING
  ACTIVE
  PAUSED
  QUARANTINED
  ARCHIVED
}

enum RegistryAutonomyLevel {
  MANUAL
  SUPERVISED
  AUTO_DISCOVERY
  POLICY_AUTO_VERIFY
  POLICY_AUTO_PUBLISH
}

enum CrawlRunStatus {
  QUEUED
  PLANNING
  CRAWLING
  EXTRACTING
  ASSESSING
  PAUSED
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

enum CrawlTaskStatus {
  QUEUED
  RUNNING
  COMPLETE
  BLOCKED
  RETRY
  FAILED
  CANCELLED
}

enum CrawlTransport {
  STATIC_HTTP
  BROWSER
}

enum RobotsDecision {
  ALLOWED
  DISALLOWED
  UNAVAILABLE
  UNREACHABLE
  ERROR
}

enum CrawlStopReason {
  FOUNDATION_FETCH_COMPLETE
  ROBOTS_BLOCKED
  POLICY_BLOCKED
  BUDGET_EXHAUSTED
  OPERATOR_PAUSED
  OPERATOR_CANCELLED
  FETCH_FAILED
  INTERNAL_ERROR
}

// ─────────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────────

model Organization {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  tier       OrgTier @default(STARTER)
  isActive   Boolean @default(true)
  adminEmail String?
  logoUrl    String?
  website    String?

  // ── Billing (Stripe) ─────────────────────────────────────
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // "active" | "trialing" | "past_due" | "canceled" | "incomplete" | "unpaid"
  currentPeriodEnd     DateTime?

  // ── GitHub publishing (optional — push-only) ──────────
  githubRepoUrl       String?
  githubDefaultBranch String? // defaults to "main" when used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  companyProfiles          CompanyProfile[]
  competitorProfiles       CompetitorProfile[]
  consultationRequests     ConsultationRequest[]
  scanSchedules            ScanSchedule[]
  notifications            Notification[]
  truthPublishRecords      TruthPublishRecord[]
  truthCanonVersions       TruthCanonVersion[]
  truthEntities            TruthEntity[]
  truthClaims              TruthClaim[]
  evidenceSources          EvidenceSource[]
  truthGraphEdges          TruthGraphEdge[]
  registryProfiles         RegistryProfile[]
  authoritySources         AuthoritySource[]
  driftRuns                DriftRun[]
  orgIntelligenceSnapshots OrgIntelligenceSnapshot[]
  serviceApiKeys           ServiceApiKey[]
  registryAutonomyPolicies RegistryAutonomyPolicy[]
  registryTargets          RegistryTarget[]
  registryCrawlRuns        RegistryCrawlRun[]
  registryCrawlTasks       RegistryCrawlTask[]
  registryPageSnapshots    RegistryPageSnapshot[]
  registryAgentDecisions   RegistryAgentDecision[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────

model User {
  id             String    @id // = Supabase auth.users.id (UUID)
  email          String    @unique
  displayName    String?
  role           UserRole  @default(CLIENT)
  organizationId String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────────
// SERVICE API KEYS (service-to-service auth)
// ─────────────────────────────────────────────────
// Issued per consumer (lmo-backend, NeuroOS hub, MCP, …) from /admin/api-keys.
// Only the SHA-256 hash of the token is stored; the plaintext token
// (vizai_sk_…) is shown exactly once at creation. Replaces the shared
// VIZAI_SERVICE_API_KEY env var (kept as deprecated fallback until cutover).

model ServiceApiKey {
  id             String    @id @default(cuid())
  name           String // consumer label, e.g. "lmo-backend forwarding"
  keyPrefix      String // display-only token prefix, e.g. "vizai_sk_ab12cd34"
  keyHash        String    @unique // SHA-256 hex of the full token
  organizationId String
  role           UserRole  @default(CLIENT)
  scopes         String[]  @default([]) // explicit service capabilities, e.g. registry:read
  isActive       Boolean   @default(true) // false = revoked
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdBy      String // admin uid or email that issued the key
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("service_api_keys")
}

// ─────────────────────────────────────────────────
// COMPANY PROFILE (Ground Truth)
// ─────────────────────────────────────────────────

model CompanyProfile {
  id             String  @id @default(cuid())
  organizationId String
  businessName   String
  websiteUrl     String?
  isActive       Boolean @default(true)

  // Ground truth fields
  officialDescription     String?  @db.Text
  officialBusinessType    String?
  officialServices        String[] @default([])
  officialLocations       String[] @default([])
  officialIndustries      String[] @default([])
  officialDifferentiators String[] @default([])
  officialCustomerTypes   String[] @default([])
  registryListingConsentAt DateTime?
  registryListingConsentedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  perceptionScans     PerceptionScan[]
  competitorProfiles  CompetitorProfile[]
  scanSchedules       ScanSchedule[]
  truthPublishRecords TruthPublishRecord[]
  truthCanonVersions  TruthCanonVersion[]
  truthEntities       TruthEntity[]
  truthClaims         TruthClaim[]
  evidenceSources     EvidenceSource[]
  truthGraphEdges     TruthGraphEdge[]
  registryProfiles    RegistryProfile[]
  authoritySources    AuthoritySource[]
  driftRuns           DriftRun[]
  registryTargets     RegistryTarget[]

  @@index([organizationId])
  @@index([businessName])
  @@map("company_profiles")
}

// ─────────────────────────────────────────────────
// PERCEPTION SCAN (Job Record)
// ─────────────────────────────────────────────────

// TODO(Sprint 4): Convert sourceType to a proper enum once values are stable.
//   Intended values: FREE_SCAN | DEMO_SEED | MANAGED | TRIAL
//   Refinement 1 (Sprint 3): Added as nullable String to preserve operational
//   lineage between free scans, demo seeds, and authenticated org scans.
//   Use organizationId='free-scan' as the primary filter for public scans;
//   sourceType provides additional lineage context when org is ambiguous.

model PerceptionScan {
  id               String     @id @default(cuid())
  organizationId   String
  companyProfileId String
  status           ScanStatus @default(PENDING)
  promptUsed       String     @db.Text
  modelsRequested  String[]
  currentStep      String?
  errorMessage     String?
  isSimulated      Boolean    @default(false)
  sourceType       String? // "FREE_SCAN" | "DEMO_SEED" | "MANAGED" | "TRIAL"

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  companyProfile  CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  modelResults    ModelResult[]
  scanReport      ScanReport?
  recommendations Recommendation[]
  embeddings      ScanEmbedding[]

  @@index([organizationId])
  @@index([companyProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("perception_scans")
}

// ─────────────────────────────────────────────────
// MODEL RESULT (Per-model AI response)
// ─────────────────────────────────────────────────

model ModelResult {
  id               String  @id @default(cuid())
  perceptionScanId String
  modelId          String // "openai:gpt-4o"
  provider         String // "openai"
  success          Boolean

  rawResponse String? @db.Text
  summary     String? @db.Text

  // Structured perception output
  businessDescription      String?  @db.Text
  businessType             String?
  servicesMentioned        String[] @default([])
  industriesMentioned      String[] @default([])
  locationsMentioned       String[] @default([])
  customerTypesMentioned   String[] @default([])
  differentiatorsMentioned String[] @default([])
  additionalClaims         String[] @default([])

  latencyMs    Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  perceptionScan PerceptionScan @relation(fields: [perceptionScanId], references: [id], onDelete: Cascade)

  @@index([perceptionScanId])
  @@map("model_results")
}

// ─────────────────────────────────────────────────
// SCAN REPORT (Aggregated analysis — 1:1 with scan)
// ─────────────────────────────────────────────────

model ScanReport {
  id               String @id @default(cuid())
  perceptionScanId String @unique

  // Comparison output
  perceptionSummary String @db.Text
  agreements        Json   @default("[]")
  differences       Json   @default("[]")
  conflicts         Json   @default("[]")

  // Scores (all 0-100)
  accuracyScore            Int              @default(100)
  coverageScore            Int              @default(100)
  entityUnderstandingScore Int              @default(0)
  consistencyScore         Int              @default(0)
  consistencyLabel         ConsistencyLabel @default(HIGH_AGREEMENT)
  consistencyNotes         String[]         @default([])

  // Detailed structured data (stored as JSON for flexibility)
  inaccuracyDetail    Json @default("{}")
  omissionDetail      Json @default("{}")
  entityUnderstanding Json @default("{}")

  // Generated reports
  markdownReport String? @db.Text
  jsonReport     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perceptionScan PerceptionScan @relation(fields: [perceptionScanId], references: [id], onDelete: Cascade)

  @@map("scan_reports")
}

// ─────────────────────────────────────────────────
// RECOMMENDATION
// ─────────────────────────────────────────────────

model Recommendation {
  id                String    @id @default(cuid())
  perceptionScanId  String? // nullable — intelligence-sourced recs have no scan
  priority          Priority
  category          String
  title             String
  reason            String    @db.Text
  recommendedAction String    @db.Text
  serviceLink       String?
  isActioned        Boolean   @default(false)
  actionedAt        DateTime?

  // ── Sprint 17: intelligence-sourced recommendations ──────────────────────
  // source: "SCAN" (default) | "INTELLIGENCE"
  // organizationId: required for INTELLIGENCE source (no scan to derive from)
  source         String?
  organizationId String?

  // Workflow status (Phase 1.7)
  status       RecommendationStatus @default(OPEN)
  openedAt     DateTime?
  inProgressAt DateTime?
  completedAt  DateTime?
  dismissedAt  DateTime?

  createdAt DateTime @default(now())

  perceptionScan PerceptionScan? @relation(fields: [perceptionScanId], references: [id], onDelete: Cascade)

  @@index([perceptionScanId])
  @@index([organizationId, source, status])
  @@index([priority])
  @@index([status])
  @@map("recommendations")
}

// ─────────────────────────────────────────────────
// COMPETITOR PROFILE
// ─────────────────────────────────────────────────

model CompetitorProfile {
  id               String   @id @default(cuid())
  organizationId   String
  companyProfileId String?
  businessName     String
  websiteUrl       String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyProfile CompanyProfile? @relation(fields: [companyProfileId], references: [id])

  @@index([organizationId])
  @@map("competitor_profiles")
}

// ─────────────────────────────────────────────────
// CONSULTATION REQUEST (CRM / Lead)
// ─────────────────────────────────────────────────

model ConsultationRequest {
  id              String   @id @default(cuid())
  organizationId  String
  contactName     String
  contactEmail    String
  contactPhone    String?
  message         String   @db.Text
  serviceInterest String?
  status          String   @default("pending") // pending | reviewed | closed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("consultation_requests")
}

// ─────────────────────────────────────────────────
// INDUSTRY QUERY LIBRARY (Global, admin-managed)
// ─────────────────────────────────────────────────

model IndustryQueryLibrary {
  id                String   @id @default(cuid())
  industry          String   @unique
  displayName       String
  promptTemplate    String   @db.Text
  exampleBusinesses String[] @default([])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("industry_query_libraries")
}

// ─────────────────────────────────────────────────
// SCAN SCHEDULE
// ─────────────────────────────────────────────────

model ScanSchedule {
  id               String             @id @default(cuid())
  organizationId   String
  companyProfileId String
  interval         RecurrenceInterval
  isActive         Boolean            @default(true)
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  modelsToUse      String[]           @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([nextRunAt])
  @@map("scan_schedules")
}

// ─────────────────────────────────────────────────
// NOTIFICATION (In-app operational events)
// ─────────────────────────────────────────────────

model Notification {
  id             String               @id @default(cuid())
  organizationId String
  type           NotificationType
  severity       NotificationSeverity
  title          String
  message        String               @db.Text
  isRead         Boolean              @default(false)
  createdAt      DateTime             @default(now())

  // Optional context links
  relatedScanId           String?
  relatedRecommendationId String?

  // Grouping key — groups related events in the UI (e.g. "scan:cuid", "billing", "onboarding")
  groupKey String?

  // Lifecycle
  // archivedAt is set when a notification ages out (>90 days, not unread CRITICAL)
  // Archived notifications are excluded from default queries.
  archivedAt DateTime?

  // Sprint 16 — Alert resolution workflow
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedBy     String? // admin userId
  resolutionNote String?   @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead])
  @@index([organizationId, createdAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, resolvedAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────
// PROCESSED STRIPE EVENT (Webhook idempotency)
// ─────────────────────────────────────────────────

model ProcessedStripeEvent {
  id          String   @id // Stripe event ID (evt_xxx) — natural unique key
  type        String
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ─────────────────────────────────────────────────
// TRUTH PUBLISH RECORD (Canonical truth publishing audit trail)
// ─────────────────────────────────────────────────

model TruthPublishRecord {
  id               String             @id @default(cuid())
  organizationId   String
  companyProfileId String
  version          Int
  status           TruthPublishStatus @default(DRAFT)

  // Canonical truth snapshot at publish time — deterministic, hash-stable
  exportPayload Json
  // SHA-256 of normalized payload — dedup: same hash = no new publish needed
  payloadHash   String

  publishedAt DateTime?
  confirmedAt DateTime?
  notes       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)

  @@unique([companyProfileId, version])
  @@index([organizationId])
  @@index([companyProfileId, status])
  @@map("truth_publish_records")
}

// ─────────────────────────────────────────────────
// TRUTH INFRASTRUCTURE (Phase 0-1)
// ─────────────────────────────────────────────────

model TruthCanonVersion {
  id               String           @id @default(cuid())
  organizationId   String
  companyProfileId String
  version          Int
  status           TruthCanonStatus @default(DRAFT)
  title            String
  summary          String?          @db.Text
  canonPayload     Json             @default("{}")
  payloadHash      String
  approvedAt       DateTime?
  approvedBy       String?
  publishedAt      DateTime?
  supersededAt     DateTime?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile   CompanyProfile    @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  entities         TruthEntity[]
  claims           TruthClaim[]
  registryProfiles RegistryProfile[]
  driftRuns        DriftRun[]

  @@unique([companyProfileId, version])
  @@index([organizationId, status])
  @@index([companyProfileId, status])
  @@map("truth_canon_versions")
}

model TruthEntity {
  id               String          @id @default(cuid())
  organizationId   String
  companyProfileId String
  canonVersionId   String?
  type             TruthEntityType
  name             String
  slug             String
  description      String?         @db.Text
  data             Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile     @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  canonVersion   TruthCanonVersion? @relation(fields: [canonVersionId], references: [id], onDelete: SetNull)
  claims         TruthClaim[]
  outgoingEdges  TruthGraphEdge[]   @relation("GraphFromEntity")
  incomingEdges  TruthGraphEdge[]   @relation("GraphToEntity")

  @@unique([organizationId, companyProfileId, type, slug])
  @@index([organizationId, type])
  @@index([companyProfileId])
  @@map("truth_entities")
}

model TruthClaim {
  id               String           @id @default(cuid())
  organizationId   String
  companyProfileId String
  canonVersionId   String?
  entityId         String?
  category         String
  statement        String           @db.Text
  value            Json             @default("{}")
  status           TruthClaimStatus @default(DRAFT)
  confidence       Int              @default(50)
  origin           ClaimOrigin      @default(OBSERVED)
  verifiedAt       DateTime?
  verifiedBy       String?
  publishAllowed   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile       @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  canonVersion   TruthCanonVersion?   @relation(fields: [canonVersionId], references: [id], onDelete: SetNull)
  entity         TruthEntity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  evidenceLinks  TruthClaimEvidence[]

  @@index([organizationId, status])
  @@index([companyProfileId, category])
  @@index([canonVersionId])
  @@map("truth_claims")
}

model EvidenceSource {
  id               String             @id @default(cuid())
  organizationId   String
  companyProfileId String
  type             EvidenceSourceType
  title            String
  url              String?
  sourceDate       DateTime?
  retrievedAt      DateTime           @default(now())
  contentHash      String?
  evidenceText     String?            @db.Text
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile       @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  claimLinks     TruthClaimEvidence[]

  @@index([organizationId, type])
  @@index([companyProfileId])
  @@index([url])
  @@map("evidence_sources")
}

model TruthClaimEvidence {
  id               String               @id @default(cuid())
  claimId          String
  evidenceSourceId String
  supportLevel     EvidenceSupportLevel @default(MODERATE)
  notes            String?              @db.Text
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionNote   String?              @db.Text
  createdAt        DateTime             @default(now())

  claim          TruthClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceSource EvidenceSource @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceSourceId])
  @@index([evidenceSourceId])
  @@map("truth_claim_evidence")
}

model TruthGraphEdge {
  id               String                 @id @default(cuid())
  organizationId   String
  companyProfileId String
  fromEntityId     String
  toEntityId       String
  relationType     TruthGraphRelationType
  claimId          String?
  weight           Int                    @default(100)
  metadata         Json                   @default("{}")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  fromEntity     TruthEntity    @relation("GraphFromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity       TruthEntity    @relation("GraphToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyProfileId, fromEntityId, toEntityId, relationType])
  @@index([organizationId, relationType])
  @@index([companyProfileId])
  @@map("truth_graph_edges")
}

model RegistryProfile {
  id               String                @id @default(cuid())
  organizationId   String
  companyProfileId String
  canonVersionId   String?
  registryId       String
  status           RegistryProfileStatus @default(DRAFT)
  payload          Json                  @default("{}")
  payloadHash      String
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

