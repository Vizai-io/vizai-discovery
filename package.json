{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "postinstall": "prisma generate",
    "build": "npm run env:check && prisma generate && next build",
    "env:check": "node scripts/check-env.mjs",
    "env:check:worker": "cross-env ENV_CHECK_ROLE=worker node scripts/check-env.mjs",
    "env:check:migration": "cross-env ENV_CHECK_ROLE=migration node scripts/check-env.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "migrations:check": "prisma validate && node scripts/check-migrations.mjs",
    "registry:worker": "tsx scripts/registry-worker.ts",
    "registry:queue:provision": "cross-env REGISTRY_QUEUE_MIGRATE=true tsx scripts/provision-registry-queue.ts",
    "test:registry-intelligence": "tsx src/lib/registry-intelligence/__tests__/foundation.spec.ts",
    "test": "tsx scripts/run-tests.ts",
    "ci:verify": "npm run env:check && npm run migrations:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.12.0",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.20",
    "patch-package": "^8.0.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.26.1",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "recharts": "^2.15.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.23.1",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "eslint": "9.39.0",
    "eslint-config-next": "15.5.20",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
