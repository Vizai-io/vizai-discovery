# Vizai-discovery environment example
# Copy to .env.local for local development. Do not commit real secrets.

# Core platform/database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vizai
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vizai
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
NEXT_PUBLIC_APP_URL=http://localhost:9002

# AI providers
OPENAI_API_KEY=CHANGE_ME
GOOGLE_GENAI_API_KEY=CHANGE_ME

# Cron/service-to-service auth
CRON_SECRET=CHANGE_ME
VIZAI_SERVICE_API_KEY=CHANGE_ME
VIZAI_SERVICE_ORG_ID=vizai-internal
# Legacy service keys only. Prefer issued service keys with persisted scopes.
VIZAI_SERVICE_SCOPES=registry:read,registry:run

# Registry Intelligence foundation worker
# Use a direct/session-capable Postgres URL. Do not use a transaction-only pooler.
REGISTRY_QUEUE_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vizai
REGISTRY_QUEUE_MIGRATE=true
REGISTRY_WORKER_CONCURRENCY=2
REGISTRY_CRAWLER_USER_AGENT=VizAI-RegistryBot/1.0 (+https://www.vizai.io/crawler)

# Snapshot storage: local for development, supabase for production.
REGISTRY_SNAPSHOT_BACKEND=local
REGISTRY_SNAPSHOT_LOCAL_DIR=.registry-snapshots
REGISTRY_SNAPSHOT_BUCKET=registry-snapshots

# Stripe test billing only - VizAI website catalog
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TIER0_SNAPSHOT_PRICE_ID=
STRIPE_TIER1_FOUNDATION_SETUP_PRICE_ID=
STRIPE_TIER1_FOUNDATION_MONTHLY_PRICE_ID=
STRIPE_TIER2_REINFORCEMENT_SETUP_PRICE_ID=
STRIPE_TIER2_REINFORCEMENT_MONTHLY_PRICE_ID=
STRIPE_TIER3_GOVERNANCE_SETUP_PRICE_ID=
STRIPE_TIER3_GOVERNANCE_MONTHLY_PRICE_ID=
STRIPE_ADDON_COMPETITOR_COMPARISON_PRICE_ID=
STRIPE_ADDON_EXTENDED_QUERY_PACK_PRICE_ID=
STRIPE_ADDON_QUARTERLY_DEEP_AUDIT_PRICE_ID=
STRIPE_ADDON_CONTENT_OPTIMIZATION_PAGE_PRICE_ID=
STRIPE_ADDON_MULTI_LANGUAGE_TESTING_PRICE_ID=
STRIPE_ADDON_PRIORITY_SUPPORT_MONTHLY_PRICE_ID=

# Backward-compatible aliases currently read by older billing code.
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
